# Chave da API da Anthropic (Claude). Crie a sua em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo Claude usado para interpretar os criativos (precisa suportar visão)
ANTHROPIC_MODEL=claude-sonnet-5

# Tamanho do modelo Whisper local para transcrição de áudio (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=base

# Quantos frames no máximo extrair por vídeo (limita custo/tamanho do prompt)
MAX_FRAMES=40

# Origem permitida para chamadas do frontend (CORS)
CORS_ORIGIN=http://localhost:5173

# Banco de dados. SQLite localmente; em produção, a URL do Postgres do Render.
DATABASE_URL=sqlite:///./data/ryber.db

# Limites de uso/abuso
MAX_UPLOAD_MB=500
MAX_CONCURRENT_ANALYSES=2
RATE_LIMIT_PER_MINUTE=5

# Sessão de login
SESSION_COOKIE_NAME=ryber_session
SESSION_TTL_DAYS=30
# false em localhost (http); true em produção (https) — cookie Secure exige HTTPS.
SESSION_COOKIE_SECURE=false

# Código exigido no cadastro, enquanto a plataforma não é divulgada publicamente.
SIGNUP_INVITE_CODE=

# E-mails (separados por vírgula) promovidos a admin (acesso a /admin) ao iniciar o app.
ADMIN_EMAILS=

# Stripe (modo teste — chaves começando com sk_test_/whsec_test_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_START=
STRIPE_PRICE_ID_PLATINUM=
STRIPE_PRICE_ID_GOLD=

# URL do frontend, usada nos redirects de sucesso/cancelamento do checkout.
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 (armazenamento) — obrigatório pra criar análises por upload de arquivo
# (o worker roda em processo separado e precisa buscar o arquivo de algum lugar
# compartilhado, não do disco local de quem recebeu o upload).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Fila de processamento (RQ). Redis local pro dev (ex: via Docker); em produção,
# a connection string do Upstash (rediss://...).
REDIS_URL=redis://localhost:6379/0
